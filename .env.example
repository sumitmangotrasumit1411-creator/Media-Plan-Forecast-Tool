# ──────────────────────────────────────────────────────────────────────────────
# Amazon Media Plan Forecast Engine — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=3072                 # Maximum upload size in MB (3 GB)
CHUNK_ROWS=300000                  # CSV chunk size (rows per chunk)

# ── Temp file storage ─────────────────────────────────────────────────────────
TMP_DIR=/tmp/mediaplan             # Directory for temporary processing files

# ── DuckDB performance ────────────────────────────────────────────────────────
DUCKDB_THREADS=4                   # Number of parallel threads
DUCKDB_MEMORY_LIMIT=4GB            # Maximum DuckDB memory usage

# ── Application authentication (optional) ─────────────────────────────────────
ENABLE_AUTH=false                  # Set to 'true' to enable password gate
APP_PASSWORD=                      # Required if ENABLE_AUTH=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR

# ── Streamlit server (set by .streamlit/config.toml normally) ─────────────────
# STREAMLIT_SERVER_MAX_UPLOAD_SIZE=3072
# STREAMLIT_SERVER_PORT=8501
